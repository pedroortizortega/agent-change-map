{
  "name": "agent-change-map",
  "displayName": "Agent Change Map",
  "description": "Navigate and compare Python structure changes safely.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agentChangeMap.compare",
        "title": "Agent Change Map: Compare Python Changes"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:webview",
    "build:webview": "tsc -p tsconfig.webview.json && node scripts/copy-webview-assets.mjs",
    "lint": "eslint src test webview --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "node scripts/vscode-harness.mjs",
    "test:docker": "vitest run --config vitest.docker.config.ts",
    "analyze:fixture": "node scripts/analyze-fixture.mjs",
    "harness:git": "node scripts/harness-git.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.35.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "zod": "^4.1.5"
  }
}
